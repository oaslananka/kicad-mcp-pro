{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Single-directory npm cutover pilot for integrations/chatgpt-app/apps-sdk. Enable only after hosted Renovate App installation is verified; draft PR must remain unmerged until then.",
  "enabled": true,
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "timezone": "Europe/Istanbul",
  "schedule": [
    "after 3am and before 7am on monday"
  ],
  "minimumReleaseAge": "5 days",
  "prConcurrentLimit": 1,
  "prHourlyLimit": 1,
  "separateMinorPatch": true,
  "rebaseWhen": "behind-base-branch",
  "automerge": false,
  "platformAutomerge": false,
  "enabledManagers": [
    "npm"
  ],
  "vulnerabilityAlerts": {
    "enabled": false,
    "minimumReleaseAge": null,
    "dependencyDashboardApproval": false
  },
  "lockFileMaintenance": {
    "enabled": false,
    "schedule": [
      "before 4am on monday"
    ],
    "automerge": false
  },
  "packageRules": [
    {
      "description": "Patch updates are candidates for a separately approved protected Mergify queue, not automatic merges.",
      "matchUpdateTypes": [
        "patch"
      ],
      "labels": [
        "dependencies",
        "renovate-patch"
      ],
      "automerge": false
    },
    {
      "description": "Minor updates need CI and explicit review during pilot.",
      "matchUpdateTypes": [
        "minor"
      ],
      "labels": [
        "dependencies",
        "renovate-minor"
      ],
      "automerge": false
    },
    {
      "description": "Breaking upgrades need Dependency Dashboard permission before creating any PR.",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true,
      "labels": [
        "dependencies",
        "renovate-major"
      ],
      "automerge": false
    }
  ],
  "includePaths": [
    "integrations/chatgpt-app/apps-sdk/**"
  ]
}
