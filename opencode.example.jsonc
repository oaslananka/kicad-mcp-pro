{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "kicad-mcp-pro": {
        "type": "local",
        "command": [
          "uvx",
          "kicad-mcp-pro",
          "--transport",
          "stdio"
        ],
        "codemode": false,
        "environment": {
          "KICAD_MCP_TRANSPORT": "stdio"
        },
        "timeout": {
          "startup": 15000,
          "catalog": 15000
        }
      }
    }
  },
  "permission": {
    "skill": {
      "kicad-design-review": "allow",
      "pcb-design": "allow",
      "drc-check": "allow",
      "fabrication-output": "allow",
      "schematic-review": "allow"
    }
  }
}
