{
  "mcpServers": {
    "kicad-mcp-pro": {
      "command": "uvx",
      "args": [
        "kicad-mcp-pro",
        "--transport",
        "stdio"
      ],
      "env": {
        "KICAD_MCP_TRANSPORT": "stdio",
        "KICAD_MCP_PROFILE": "default",
        "KICAD_MCP_OPERATING_MODE": "readonly"
      }
    }
  }
}
