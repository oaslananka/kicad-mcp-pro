{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "kicad": {
        "type": "local",
        "command": [
          "uvx",
          "kicad-mcp-pro",
          "--transport",
          "stdio"
        ],
        "environment": {
          "KICAD_MCP_PROJECT_DIR": ".",
          "KICAD_MCP_PROFILE": "default",
          "KICAD_MCP_OPERATING_MODE": "readonly"
        },
        "codemode": false
      }
    }
  },
  "instructions": [
    "AGENTS.md",
    ".opencode/kicad-instructions.md"
  ],
  "permissions": [
    {
      "action": "kicad_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    }
  ],
  "agents": {
    "pcb-review": {
      "description": "KiCad PCB review and manufacturing readiness agent",
      "mode": "primary",
      "permissions": [
        {
          "action": "kicad_*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "ask"
        }
      ]
    }
  }
}
