{
  "name": "kicad-mcp-pro",
  "version": "4.4.0",
  "description": "Read-only KiCad MCP Pro server and portable PCB review skills for Gemini CLI.",
  "mcpServers": {
    "kicad": {
      "command": "uvx",
      "args": [
        "kicad-mcp-pro",
        "--transport",
        "stdio"
      ],
      "env": {
        "KICAD_MCP_PROFILE": "default",
        "KICAD_MCP_OPERATING_MODE": "readonly"
      }
    }
  }
}
