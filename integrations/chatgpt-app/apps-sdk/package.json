{
  "name": "kicad-mcp-chatgpt-app",
  "version": "0.2.0",
  "private": true,
  "description": "ChatGPT App for KiCad PCB project analysis and manufacturing readiness",
  "type": "module",
  "scripts": {
    "dev": "tsx watch -r dotenv/config src/server.ts",
    "build": "tsc",
    "start": "node --import dotenv/config dist/server.js",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node --test test/app-smoke.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dotenv": "^18.0.8",
    "express": "5.3.0",
    "express-rate-limit": "^8.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@hono/node-server": "2.1.5",
    "hono": "4.13.13",
    "fast-uri": "3.1.9",
    "qs": "6.16.1",
    "ip-address": "10.7.4"
  }
}
