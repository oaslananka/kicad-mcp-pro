{
  "name": "kicad-mcp-chatgpt-app",
  "version": "0.2.0",
  "private": true,
  "description": "ChatGPT App for KiCad PCB project analysis and manufacturing readiness",
  "type": "module",
  "scripts": {
    "dev": "tsx watch -r dotenv/config src/server.ts",
    "build": "tsc",
    "start": "node --import dotenv/config dist/server.js",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node --test test/app-smoke.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.4.0",
    "express": "4.22.2",
    "express-rate-limit": "^8.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "express@4.22.2": {
      "body-parser": "1.20.6"
    },
    "@hono/node-server": "2.0.11",
    "hono": "4.12.34",
    "fast-uri": "3.1.5"
  }
}
