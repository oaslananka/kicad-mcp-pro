{
  "schema_version": 1,
  "repository_settings": {
    "allowed_actions": "selected",
    "can_approve_pull_request_reviews": false,
    "default_workflow_permissions": "read",
    "github_owned_allowed": true,
    "sha_pinning_required": true,
    "verified_allowed": true
  },
  "github_owned_action_owners": [
    "actions",
    "github"
  ],
  "allowed_action_repositories": [
    "aquasecurity/trivy-action",
    "astral-sh/setup-uv",
    "codecov/codecov-action",
    "CodSpeedHQ/action",
    "docker/build-push-action",
    "docker/login-action",
    "docker/metadata-action",
    "docker/setup-buildx-action",
    "docker/setup-qemu-action",
    "dorny/paths-filter",
    "google/osv-scanner-action",
    "googleapis/release-please-action",
    "ossf/scorecard-action",
    "peaceiris/actions-gh-pages",
    "pypa/gh-action-pypi-publish",
    "sigstore/cosign-installer",
    "SonarSource/sonarqube-scan-action"
  ],
  "workflow_write_permissions": {
    "auto-assign.yml": {
      "assign": [
        "issues"
      ]
    },
    "ci.yml": {
      "security": [
        "security-events"
      ],
      "coverage": [
        "id-token"
      ]
    },
    "codeql.yml": {
      "analyze": [
        "security-events"
      ]
    },
    "codspeed.yml": {
      "benchmarks": [
        "id-token"
      ]
    },
    "docs.yml": {
      "deploy": [
        "contents"
      ]
    },
    "gui-release.yml": {
      "create-release": [
        "artifact-metadata",
        "attestations",
        "contents",
        "id-token"
      ]
    },
    "osv-inventory-weekly.yml": {
      "osv-full-inventory": [
        "security-events"
      ]
    },
    "prepare-kicad-pcm.yml": {
      "prepare": [
        "artifact-metadata",
        "attestations",
        "id-token"
      ]
    },
    "publish-kicad-pcm.yml": {
      "publish": [
        "artifact-metadata",
        "attestations",
        "contents",
        "id-token"
      ]
    },
    "publish-mcp-container.yml": {
      "publish": [
        "attestations",
        "id-token",
        "packages"
      ]
    },
    "publish-mcp-registry.yml": {
      "publish": [
        "id-token"
      ]
    },
    "publish-mcpb.yml": {
      "publish": [
        "artifact-metadata",
        "attestations",
        "contents",
        "id-token"
      ]
    },
    "publish-npm.yml": {
      "publish": [
        "artifact-metadata",
        "attestations",
        "contents",
        "id-token"
      ]
    },
    "publish-protocol-schemas.yml": {
      "publish": [
        "artifact-metadata",
        "attestations",
        "contents",
        "id-token"
      ]
    },
    "publish-python.yml": {
      "build": [
        "artifact-metadata",
        "attestations",
        "contents",
        "id-token"
      ],
      "publish-pypi": [
        "id-token"
      ],
      "publish-testpypi": [
        "id-token"
      ]
    },
    "scorecard.yml": {
      "analysis": [
        "id-token",
        "security-events"
      ]
    },
    "uv-dependency-submission.yml": {
      "submit-uv-lock": [
        "contents"
      ]
    }
  },
  "required_codeowner_rules": [
    "* @oaslananka",
    "/.github/CODEOWNERS @oaslananka",
    "/.github/actions-policy.json @oaslananka",
    "/.github/workflows/ @oaslananka",
    "/.release-please-manifest.json @oaslananka",
    "/SECURITY.md @oaslananka",
    "/package.json @oaslananka",
    "/packages/*/package.json @oaslananka",
    "/pyproject.toml @oaslananka",
    "/release-please-config.json @oaslananka",
    "/scripts/check_github_actions_policy.py @oaslananka",
    "/server.json @oaslananka"
  ],
  "allowed_transitive_action_repositories": [
    "aquasecurity/setup-trivy"
  ],
  "protected_publish_environments": {
    "npm": {
      "required_reviewers": []
    },
    "mcp-registry": {
      "required_reviewers": []
    },
    "ghcr": {
      "required_reviewers": []
    }
  },
  "release_asset_mutations": [
    {
      "workflow": "publish-release.yml",
      "job": "publish",
      "step": "Publish merged Release Please versions",
      "kind": "create_release",
      "clobber": false,
      "issue": "#1179",
      "reason": "release-please-action (skip-github-release: false) creates published, non-draft releases and tags before any family attaches assets; the target is a draft release published only after asset inventory verification."
    },
    {
      "workflow": "publish-python.yml",
      "job": "build",
      "step": "Attach Python evidence to GitHub Release",
      "kind": "upload_asset",
      "clobber": true,
      "issue": "#1179",
      "reason": "Python wheel/sdist, SHA256SUMS, SBOM and release evidence are uploaded with --clobber after Release Please has already published the mcp-server release."
    },
    {
      "workflow": "publish-npm.yml",
      "job": "publish",
      "step": "Attach npm evidence to GitHub Release",
      "kind": "upload_asset",
      "clobber": true,
      "issue": "#1179",
      "reason": "npm launcher tarball, SHA256SUMS and SBOM are uploaded with --clobber from a release:published run."
    },
    {
      "workflow": "publish-npm.yml",
      "job": "publish",
      "step": "Attach npm post-publish verification to GitHub Release",
      "kind": "upload_asset",
      "clobber": true,
      "issue": "#1179",
      "reason": "npm-published-digest.json is produced after npm publish and uploaded with --clobber onto the published release; it must move to attestations/workflow artifacts or run before release publication."
    },
    {
      "workflow": "publish-mcpb.yml",
      "job": "publish",
      "step": "Attach MCPB bundle and evidence to GitHub Release",
      "kind": "upload_asset",
      "clobber": true,
      "issue": "#1179",
      "reason": "MCPB bundle and evidence are uploaded with --clobber from a release:published run."
    },
    {
      "workflow": "publish-protocol-schemas.yml",
      "job": "publish",
      "step": "Attach evidence to GitHub Release",
      "kind": "upload_asset",
      "clobber": true,
      "issue": "#1179",
      "reason": "Protocol schemas tarball, SHA256SUMS and SBOM are uploaded with --clobber from a release:published run."
    },
    {
      "workflow": "publish-kicad-pcm.yml",
      "job": "publish",
      "step": "Attach KiCad PCM package and evidence to GitHub Release",
      "kind": "upload_asset",
      "clobber": true,
      "issue": "#1179",
      "reason": "KiCad PCM package and evidence are uploaded with --clobber from a release:published run."
    },
    {
      "workflow": "gui-release.yml",
      "job": "create-release",
      "step": "Prepare release inventory",
      "kind": "create_release",
      "clobber": false,
      "issue": "#1179",
      "reason": "Creates a non-draft GUI release with gh release create when Publish Release has not created it yet (race with Release Please); draft-first orchestration removes this path."
    },
    {
      "workflow": "gui-release.yml",
      "job": "create-release",
      "step": "Upload installers and evidence to GitHub Release",
      "kind": "upload_asset",
      "clobber": true,
      "issue": "#1179",
      "reason": "GUI installers and evidence are uploaded with --clobber onto an already published kicad-mcp-gui release."
    }
  ]
}
