{
  "name": "kicad-mcp-pro-server",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.6",
  "scripts": {
    "metadata:sync": "uv run --all-extras python scripts/sync_mcp_metadata.py --write",
    "metadata:check": "uv run --all-extras python scripts/sync_mcp_metadata.py --check",
    "dev:bootstrap": "./scripts/bootstrap-dev.sh",
    "dev:doctor": "uv run --all-extras python scripts/dev_environment.py --doctor",
    "cloud:check": "npm --prefix apps/cloud run check",
    "cloud:build": "npm --prefix apps/cloud run build",
    "deploy": "gh workflow run cloud-deploy.yml --repo oaslananka/kicad-mcp-pro --ref main",
    "assets:icons": "uv run --all-extras python scripts/render_icons.py",
    "assets:icons:check": "uv run --all-extras python scripts/check_icon_assets.py",
    "assets:demo": "uv run --all-extras python scripts/generate_synthetic_demo.py --convert-if-available",
    "assets:screenshots": "uv run --all-extras python scripts/render_screenshots.py",
    "mcp:manifest:check": "uv run --all-extras python scripts/validate_mcp_manifest.py server.json",
    "mcpb:validate": "npx -y @anthropic-ai/mcpb@2.1.2 validate packaging/mcpb/manifest.json",
    "mcpb:pack": "npx -y @anthropic-ai/mcpb@2.1.2 pack packaging/mcpb dist/kicad-mcp-pro.mcpb",
    "docker:metadata:check": "uv run --all-extras python scripts/check_docker_metadata.py",
    "publish:mcp:dry-run": "uv run --all-extras python scripts/publish_mcp_registry.py --dry-run",
    "release:check": "uv run --all-extras python scripts/check_release_preflight.py",
    "submission:check": "uv run --all-extras python scripts/check_submission_readiness.py",
    "docs:tools": "uv run --all-extras python scripts/generate_tools_reference.py",
    "docs:tools:check": "uv run --all-extras python scripts/generate_tools_reference.py --check",
    "parity:build": "uv run --all-extras python scripts/build_parity_matrix.py",
    "parity:check": "uv run --all-extras python scripts/build_parity_matrix.py --check",
    "parity:check:regression": "uv run --all-extras python scripts/build_parity_matrix.py --check-regression",
    "parity:baseline": "uv run --all-extras python scripts/build_parity_matrix.py --update-baseline",
    "toolsets:build": "uv run --all-extras python scripts/build_toolsets.py",
    "toolsets:check": "uv run --all-extras python scripts/build_toolsets.py --check",
    "tool-effects:build": "uv run --all-extras python scripts/build_tool_effect_manifest.py",
    "tool-effects:check": "uv run --all-extras python scripts/build_tool_effect_manifest.py --check",
    "capabilities:build": "uv run --all-extras python scripts/build_capability_catalog.py",
    "capabilities:check": "uv run --all-extras python scripts/build_capability_catalog.py --check",
    "cloud:direct-tools:build": "uv run --all-extras python scripts/build_cloud_direct_tools.py",
    "cloud:direct-tools:check": "uv run --all-extras python scripts/build_cloud_direct_tools.py --check",
    "tool-contracts:check": "uv run --all-extras python scripts/check_tool_contracts.py",
    "architecture:check": "uv run --all-extras python scripts/check_architecture_boundaries.py",
    "lint": "uv run --all-extras ruff check src/ tests/ scripts/",
    "format": "uv run --all-extras ruff format src/ tests/",
    "format:check": "uv run --all-extras ruff format --check src/ tests/",
    "typecheck": "uv run --all-extras python -m mypy src/kicad_mcp/",
    "test": "uv run --all-extras python scripts/run_pytest.py full",
    "test:unit": "uv run --all-extras python scripts/run_pytest.py unit",
    "test:benchmark": "uv run --all-extras python scripts/run_pytest.py benchmark",
    "test:transport-contract": "uv run --all-extras python scripts/run_pytest.py transport-contract",
    "test:kicad-cli-contract": "uv run --all-extras python scripts/kicad_canary.py run --artifacts artifacts/kicad-cli-contract/local --kicad-range 10.0.x",
    "test:kicad-cli-contract:nightly": "uv run --all-extras python scripts/kicad_canary.py run --artifacts artifacts/kicad-cli-contract/nightly --kicad-range 10.99.x",
    "test:kicad-cli-contract:future": "uv run --all-extras python scripts/kicad_canary.py run --artifacts artifacts/kicad-cli-contract/kicad11 --kicad-range 11.0.x",
    "test:kicad-cli-contract:matrix": "uv run --all-extras python scripts/kicad_canary.py matrix",
    "test:gui-smoke": "uv run --all-extras python scripts/run_pytest.py gui",
    "test:advanced": "uv run --all-extras pytest tests/advanced/ -v",
    "test:advanced:property": "uv run --all-extras pytest tests/advanced/test_hypothesis_invariants.py tests/advanced/test_stateful_lifecycle.py -v",
    "test:advanced:differential": "uv run --all-extras pytest tests/advanced/test_kicad_differential.py -v",
    "test:advanced:concurrency": "uv run --all-extras pytest tests/advanced/test_concurrency_race.py -v",
    "test:advanced:faults": "uv run --all-extras pytest tests/advanced/test_fault_injection.py -v",
    "test:advanced:mcp": "uv run --all-extras pytest tests/advanced/test_mcp_protocol_advanced.py -v",
    "test:advanced:mutation": "uv run --all-extras python scripts/advanced_testing/run_mutation.py --target ipc --timeout 30",
    "test:advanced:fuzz": "uv run --all-extras python scripts/advanced_testing/run_fuzz.py --runs 512",
    "test:advanced:memory": "uv run --all-extras python scripts/advanced_testing/run_memory_profile.py --iterations 30",
    "test:advanced:security": "uv run --all-extras python scripts/advanced_testing/run_security_audit.py",
    "test:advanced:load": "uv run --all-extras python scripts/advanced_testing/run_load_test.py --vus 10 --requests 100",
    "test:advanced:report": "uv run --all-extras python scripts/advanced_testing/report_collector.py",
    "build": "uv build",
    "package:check": "uv build && uv run --all-extras python scripts/check_package_metadata.py",
    "workflows:policy": "uv run --all-extras python scripts/check_github_actions_policy.py",
    "workflows:lint": "uv run --all-extras python scripts/check_workflows.py --actionlint",
    "workflows:security": "pnpm run workflows:policy && uv run --all-extras python scripts/workflow_security.py --min-severity high",
    "security:bandit": "uv run --all-extras python scripts/check_bandit_policy.py",
    "security:audit": "uv run --all-extras python scripts/audit_dependencies.py",
    "security:node": "node --test tests/js/*.test.mjs",
    "security": "pnpm run security:bandit && pnpm run security:audit && pnpm run security:node",
    "security:local": "uv run --all-extras python scripts/security_local.py",
    "check": "pnpm run check:meta && pnpm run check:release && pnpm run check:lint && pnpm run check:type && pnpm run check:test && pnpm run check:security && pnpm run check:workflows && pnpm run check:build",
    "check:format": "pnpm run format:check",
    "check:lint": "pnpm run format:check && pnpm run lint",
    "check:type": "pnpm run typecheck",
    "check:test": "pnpm run test",
    "check:bandit": "pnpm run security:bandit",
    "check:audit": "pnpm run security:audit",
    "check:metadata": "pnpm run metadata:check",
    "check:security": "pnpm run security:bandit && pnpm run security:audit",
    "check:meta": "pnpm run metadata:check && pnpm run assets:icons:check && pnpm run mcp:manifest:check && pnpm run docker:metadata:check && pnpm run docs:tools:check && pnpm run parity:check && pnpm run parity:check:regression && pnpm run toolsets:check && pnpm run profiles:check && pnpm run adapter-matrix:check && pnpm run tool-effects:check && pnpm run capabilities:check && pnpm run cloud:direct-tools:check && pnpm run tool-contracts:check && pnpm run architecture:check && pnpm run compat:check",
    "check:release": "pnpm run release:check && pnpm run submission:check && pnpm run release:dry-run",
    "check:build": "pnpm run build && pnpm run package:check",
    "check:workflows": "pnpm run workflows:lint && pnpm run workflows:security",
    "check:ci": "pnpm run check",
    "hooks:pre-commit": "lefthook run pre-commit",
    "hooks:pre-push": "lefthook run pre-push",
    "hooks:security": "pnpm run security",
    "compat:check": "uv run --all-extras python scripts/check_no_pcbnew.py && uv run --all-extras python scripts/build_adapter_matrix.py --check && uv run --all-extras python scripts/check_compatibility_matrix.py && uv run --all-extras python scripts/runtime_policy.py check",
    "release:dry-run": "pnpm run metadata:check && pnpm run release:check",
    "profiles:build": "uv run --all-extras python scripts/profile_surface_report.py",
    "profiles:check": "uv run --all-extras python scripts/profile_surface_report.py --check",
    "adapter-matrix:build": "uv run --all-extras python scripts/build_adapter_matrix.py",
    "adapter-matrix:check": "uv run --all-extras python scripts/build_adapter_matrix.py --check",
    "hooks:install": "python scripts/install_git_hooks.py",
    "deploy:check": "gh workflow run cloud-deploy-preflight.yml --repo oaslananka/kicad-mcp-pro --ref main"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/ext-tasks": "0.2.3",
    "lefthook": "2.2.2"
  },
  "engines": {
    "node": ">=24.22.3 <25 || >=26.13.1 <27",
    "pnpm": ">=11.0.0 <12"
  },
  "version": "4.20.2"
}
