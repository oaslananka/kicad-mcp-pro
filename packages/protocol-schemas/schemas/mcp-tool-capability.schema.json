{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oaslananka.github.io/kicad-mcp-pro/schemas/mcp-tool-capability.schema.json",
  "title": "MCP tool capability metadata contract",
  "description": "Versioned metadata for a single advertised kicad-mcp-pro tool capability.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "profiles",
    "category",
    "tier",
    "runtime",
    "writes_files",
    "writes_kicad_gui_state",
    "supports_dry_run",
    "supports_rollback",
    "human_gate_required",
    "requires_human_confirmation",
    "description",
    "verification_level",
    "maturity",
    "advisory_level",
    "tested_kicad_versions"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "#/$defs/semver"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "uniqueItems": true
    },
    "category": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "tier": {
      "enum": ["read", "write", "export", "publish", "human_only"]
    },
    "runtime": {
      "enum": [
        "none",
        "kicad_cli",
        "kicad_ipc",
        "ngspice",
        "freerouting",
        "docker",
        "network"
      ]
    },
    "writes_files": {
      "type": "boolean"
    },
    "writes_kicad_gui_state": {
      "type": "boolean"
    },
    "supports_dry_run": {
      "type": "boolean"
    },
    "supports_rollback": {
      "type": "boolean"
    },
    "human_gate_required": {
      "type": "boolean"
    },
    "requires_human_confirmation": {
      "type": "boolean"
    },
    "description": {
      "type": "string"
    },
    "verification_level": {
      "enum": ["verified", "experimental", "planned"]
    },
    "maturity": {
      "enum": ["stable", "beta", "experimental", "advisory", "deprecated"]
    },
    "advisory_level": {
      "enum": ["none", "advisory", "requires_evidence", "human_review"]
    },
    "tested_kicad_versions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "inputSchema": {
      "type": "object"
    },
    "annotations": {
      "type": "object"
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  },
  "x-kicad-studio-kit": {
    "trackingIssue": "OASLANA-52",
    "schemaVersion": "1.0.0"
  },
  "x-kicad-mcp": {
    "trackingIssue": "OASLANA-52",
    "schemaType": "protocol-contract"
  }
}
